#Heatmap settings
pheatmap(
avg_matrix,
main              = "PC9 Gene Expression Under Osimertinib",
color             = heatmap_colors,
scale             = "row",
cluster_rows      = TRUE,
cluster_cols      = FALSE,
gaps_row          = row_gaps,
gaps_col          = col_gaps_avg,
annotation_row    = gene_categories,
annotation_col    = avg_annot,
annotation_colors = category_colors,
fontsize          = 11,
fontsize_row      = 12,
fontsize_col      = 11,
angle_col         = 45,
border_color      = NA,
cellwidth         = 45,
cellheight        = 22
)
